{
  "manifest_version": 2,
  "name": "Spam Sweeper",
  "version": "1.2.0",
  "description": "Group the current folder by sender, mark mail read, delete it, and manage the mailSweeperSpam filter.",
  "browser_specific_settings": {
    "gecko": {
      "id": "mailsweeper@local.invalid",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["accountsRead", "messagesRead", "messagesUpdate", "messagesDelete"],
  "browser_action": {
    "default_title": "Mail Sweeper",
    "default_popup": "popup.html"
  },
  "experiment_apis": {
    "spamFilter": {
      "schema": "experiments/spamFilter/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["spamFilter"]],
        "script": "experiments/spamFilter/api.js"
      }
    }
  }
}
